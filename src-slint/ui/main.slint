import { Button, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    in property <string> workspace-title;
    in property <string> status-text;
    in property <[string]> explorer-entries;
    in property <[string]> open-tabs;
    in-out property <string> editor-text;

    callback open-sample-document();
    callback save-active-document();
    callback editor-edited(string);
    callback select-utility-tab(string);

    title: "Hematite";
    width: 1280px;
    height: 820px;
    background: #10141b;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 42px;
            background: #151b24;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 12px;

                Text {
                    text: "Hematite";
                    color: #edf5ff;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.workspace-title;
                    color: #9fb2c7;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "Open sample";
                    clicked => { root.open-sample-document(); }
                }

                Button {
                    text: "Save";
                    clicked => { root.save-active-document(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            Rectangle {
                width: 56px;
                background: #0d1117;

                VerticalLayout {
                    padding-top: 10px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    Button {
                        text: "A";
                        clicked => { root.select-utility-tab("Agents"); }
                    }

                    Button {
                        text: "T";
                        clicked => { root.select-utility-tab("Tooling"); }
                    }

                    Button {
                        text: "O";
                        clicked => { root.select-utility-tab("Outline"); }
                    }
                }
            }

            Rectangle {
                width: 260px;
                background: #111820;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: "Explorer";
                        color: #e8f0f8;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    for entry in root.explorer-entries : Button {
                        text: entry;
                        clicked => { root.open-sample-document(); }
                    }
                }
            }

            Rectangle {
                background: #171b23;
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: 36px;
                        background: #131922;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            for tab in root.open-tabs : Rectangle {
                                min-width: 92px;
                                background: #202938;
                                border-color: #303b4e;
                                border-width: 1px;

                                Text {
                                    text: tab;
                                    color: #e8f0f8;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    TextEdit {
                        text <=> root.editor-text;
                        edited(value) => { root.editor-edited(value); }
                        font-family: "JetBrains Mono";
                        font-size: 14px;
                        vertical-stretch: 1;
                    }
                }
            }

            Rectangle {
                width: 300px;
                background: #121922;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "Agents";
                        color: #e8f0f8;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Codex, Gemini CLI, Claude Code, and Kilo surfaces will attach here after the shell proves out.";
                        color: #aebed0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Tooling";
                        color: #e8f0f8;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Ruff, ty, rust-analyzer, and cargo actions stay Rust-owned.";
                        color: #aebed0;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "Built with Slint";
                        color: #7f95ad;
                        font-size: 11px;
                    }
                }
            }
        }

        Rectangle {
            height: 26px;
            background: #0f151d;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: root.status-text;
                    color: #b8c7d9;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: "Slint MVP";
                    color: #7f95ad;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
